  "description": "Assignment for Software Engineering School",
  "main": "dist/index.js",
  "scripts": {
    "eslint": "eslint --ext .ts services",
    "prettier": "prettier services --write",
    "prettier:check": "prettier services --check ",
    "dotenv": "node ./node_modules/dotenv/lib/main.js",
    "build": "tsc",
    "start": "ts-node ./dist",
    "dev:start": "npm-run-all build start",
    "dev": "dotenv -- nodemon --watch src -e ts,ejs --exec npm run dev:start",
    "test": "jest  --testPathIgnorePatterns=\\(/dist/\\) --setupFiles dotenv/config "
  },
  "pre-commit": [
    "eslint",
    "prettier:check"
  ],
  "keywords": [],
  "author": "Arina Kysilova",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "jest": "^29.7.0",
    "joi": "^17.4.1",
    "nodemailer": "^6.9.13",
    "sinon": "^18.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "tsarch": "^5.4.0",
    "pre-commit": "^1.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.12",
    "@types/node": "^16.4.1",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^5.35.1",
    "@typescript-eslint/parser": "^5.35.1",
    "eslint": "^7.31.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.2",
    "ts-node": "^10.2.1",
    "typescript": "^4.3.5"
  }
