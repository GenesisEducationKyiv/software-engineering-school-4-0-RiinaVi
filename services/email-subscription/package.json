{
  "name": "email-subscription-service",
  "version": "1.0.0",
  "description": "Email Subscription Service",
  "main": "dist/index.js",
  "scripts": {
    "dotenv": "node ./node_modules/dotenv/lib/main.js",
    "build": "tsc",
    "start": "ts-node ./dist",
    "dev:start": "npm-run-all build start",
    "dev": "dotenv -- nodemon --watch src -e ts,ejs --exec npm run dev:start",
    "typeorm": "./node_modules/.bin/ts-node ./node_modules/.bin/typeorm",
    "typeorm:run": "dotenv -- npm run typeorm migration:run -- -d ./src/ormconfig.ts",
    "typeorm:revert": "dotenv -- npm run typeorm migration:revert -- -d ./src/ormconfig.ts",
    "test": "jest --setupFiles dotenv/config",
    "test:load": "k6 run -e PORT=8020"
  },
  "keywords": [],
  "author": "Arina Kysilova",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "jest": "^29.7.0",
    "joi": "^17.4.1",
    "k6": "^0.0.0",
    "pg": "^8.7.1",
    "ts-jest": "^29.1.2",
    "tsarch": "^5.4.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.12",
    "@types/k6": "^0.51.0",
    "@types/node": "^16.4.1",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.2.1",
    "typescript": "^4.3.5"
  }
}
